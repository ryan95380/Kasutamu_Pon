{% extends 'base.html.twig' %}

{% block body %}

<section class="auth-section">

    <div class="auth-box-custom">

        <h2>Connexion</h2>

        {# Affiche un message si Symfony retourne une erreur de connexion. #}
        {% if error %}
            <p style="color:red;">Email ou mot de passe incorrect</p>
        {% endif %}

        {# Formulaire traité par le système de sécurité Symfony. #}
        <form method="post">

            <label>Email</label>
            <input type="email" name="email" value="{{ last_username }}" required>

            <label>Mot de passe</label>
            <input type="password" name="password" required>

            {# Jeton CSRF obligatoire pour sécuriser l'authentification. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>

        </form>

        <p style="margin-top:15px;">
            Pas de compte ?
            <a href="{{ path('app_inscription') }}">S'inscrire</a>
        </p>

    </div>

</section>

{% endblock %}
