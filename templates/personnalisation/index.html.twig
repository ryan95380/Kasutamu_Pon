{% extends 'base.html.twig' %}

{% block title %}Personnalisation{% endblock %}

{% block body %}

<section class="custom-page">

    <h2 class="custom-title">
        Personnalisation de ma figurine
    </h2>

    <!-- TABS -->

    <div class="tabs">

        <button
            onclick="showCategory('cheveux')"
            class="tab active"
        >
            Cheveux
        </button>

        <button
            onclick="showCategory('costumes')"
            class="tab"
        >
            Vêtements
        </button>

        <button
            onclick="showCategory('accessoires')"
            class="tab"
        >
            Accessoires
        </button>

        <button class="tab">
            Résumé
        </button>

    </div>

    <!-- MAIN CONTAINER -->

    <div class="custom-container">

        <!-- LEFT -->

        <div class="custom-left">

            <!-- CHEVEUX -->

            <div id="cheveux" class="category">

                <div class="item-card">

                    <img src="{{ asset('images/Hair1.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine-moderne-classique1.png',
                            'Cheveux Moderne 1',
                            20
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

                <div class="item-card">

                    <img src="{{ asset('images/Hair2.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine-moderne-classique2.png',
                            'Cheveux Moderne 2',
                            20
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

                <div class="item-card">

                    <img src="{{ asset('images/Hair3.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine-moderne-classique3.png',
                            'Cheveux Moderne 3',
                            20
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

                <div class="item-card">

                    <img src="{{ asset('images/Hair4.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine-moderne-classique4.png',
                            'Cheveux Moderne 4',
                            20
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

            </div>

            <!-- COSTUMES -->

            <div id="costumes" class="category hidden">

                <div class="item-card">

                    <img src="{{ asset('images/costume1.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'Figurine_costume1.png',
                            'Costume Premium',
                            35
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

                <div class="item-card">

                    <img src="{{ asset('images/Shogun2.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine-shogun-elegant.png',
                            'Armure Shogun',
                            40
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

                <div class="item-card">

                    <img src="{{ asset('images/imperiale3.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine-samourai-imperial.png',
                            'Armure Impériale',
                            45
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

            </div>

            <!-- ACCESSOIRES -->

            <div id="accessoires" class="category hidden">

                <div class="item-card">

                    <img src="{{ asset('images/chapeau1.png') }}">

                    <button
                        class="item-btn"
                        onclick="
                        changeFigurine(
                            'figurine_chapeau1.png',
                            'Chapeau Traditionnel',
                            15
                        )
                        "
                    >
                        Ajouter
                    </button>

                </div>

            </div>

        </div>

        <!-- CENTER -->

        <div class="custom-center">

            <button class="arrow">
                ❮
            </button>

            <img
                id="figurine-preview"
                src="{{ asset('images/' ~ figurine.image) }}"
                class="figurine-img"
            >

            <button class="arrow">
                ❯
            </button>

        </div>

        <!-- RIGHT -->

        <div class="custom-right">

            <div class="resume-line">

                <span>Prix</span>

                <span>
                    {{ figurine.prixBase }} €
                </span>

            </div>

            <div class="resume-line">

                <span>Personnalisation</span>

                <span id="custom-name">
                    Aucune
                </span>

            </div>

            <div class="resume-line">

                <span>Total personnalisation</span>

                <span id="custom-price">
                    0 €
                </span>

            </div>

            <div class="resume-line total">

                <span>Total</span>

                <span id="total-price">
                    {{ figurine.prixBase }} €
                </span>

            </div>

            <a
                id="btn-panier"
                href="{{ path('panier_add', {
                    id: figurine.id
                }) }}"
                class="btn-panier"
            >
                Ajouter au panier
            </a>

        </div>

    </div>

</section>

<script>

let basePrice = {{ figurine.prixBase }};

function changeFigurine(
    image,
    customName = 'Personnalisation',
    extraPrice = 20
)
{
    /* CHANGE IMAGE */

    document.getElementById(
        'figurine-preview'
    ).src =
        "/images/" + image;

    /* CHANGE RESUME */

    document.getElementById(
        'custom-name'
    ).innerText =
        customName;

    document.getElementById(
        'custom-price'
    ).innerText =
        extraPrice + " €";

    document.getElementById(
        'total-price'
    ).innerText =
        (basePrice + extraPrice) + " €";

    /* CHANGE URL PANIER */

    document.getElementById(
        'btn-panier'
    ).href =
        "/panier/add/{{ figurine.id }}"
        + "?image=" + image
        + "&custom=" + customName
        + "&prix=" + (basePrice + extraPrice);
}

function showCategory(category)
{
    document
        .querySelectorAll('.category')
        .forEach(cat => {

            cat.classList.add('hidden');

        });

    document
        .getElementById(category)
        .classList.remove('hidden');
}

</script>

{% endblock %}