{% extends 'base.html.twig' %}

{% block title %}Personnalisation{% endblock %}

{% block body %}

<section class="custom-page">

    <h2 class="custom-title">
        Personnalisation de ma figurine
    </h2>

    <div class="tabs">
        <button type="button" onclick="showCategory('cheveux', this)" class="tab active">Cheveux</button>
        <button type="button" onclick="showCategory('costumes', this)" class="tab">Vêtements</button>
        <button type="button" onclick="showCategory('accessoires', this)" class="tab">Accessoires</button>
        <button type="button" class="tab">Résumé</button>
    </div>

    <div class="custom-container">

        <div class="custom-left">

            {# Options visuelles proposées pour la figurine sélectionnée. #}
            <div id="cheveux" class="category">

                <div class="item-card">
                    <img src="{{ asset('images/Hair1.png') }}" alt="Cheveux moderne 1">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine-moderne-classique1.png', 'Cheveux Moderne 1', 20)">Ajouter</button>
                </div>

                <div class="item-card">
                    <img src="{{ asset('images/Hair2.png') }}" alt="Cheveux moderne 2">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine-moderne-classique2.png', 'Cheveux Moderne 2', 20)">Ajouter</button>
                </div>

                <div class="item-card">
                    <img src="{{ asset('images/Hair3.png') }}" alt="Cheveux moderne 3">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine-moderne-classique3.png', 'Cheveux Moderne 3', 20)">Ajouter</button>
                </div>

                <div class="item-card">
                    <img src="{{ asset('images/Hair4.png') }}" alt="Cheveux moderne 4">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine-moderne-classique4.png', 'Cheveux Moderne 4', 20)">Ajouter</button>
                </div>

            </div>

            <div id="costumes" class="category hidden">

                <div class="item-card">
                    <img src="{{ asset('images/costume1.png') }}" alt="Costume premium">
                    <button type="button" class="item-btn" onclick="changeFigurine('Figurine_costume1.png', 'Costume Premium', 35)">Ajouter</button>
                </div>

                <div class="item-card">
                    <img src="{{ asset('images/Shogun2.png') }}" alt="Armure shogun">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine-shogun-elegant.png', 'Armure Shogun', 40)">Ajouter</button>
                </div>

                <div class="item-card">
                    <img src="{{ asset('images/imperiale3.png') }}" alt="Armure impériale">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine-samourai-imperial.png', 'Armure Impériale', 45)">Ajouter</button>
                </div>

            </div>

            <div id="accessoires" class="category hidden">

                <div class="item-card">
                    <img src="{{ asset('images/chapeau1.png') }}" alt="Chapeau traditionnel">
                    <button type="button" class="item-btn" onclick="changeFigurine('figurine_chapeau1.png', 'Chapeau Traditionnel', 15)">Ajouter</button>
                </div>

            </div>

        </div>

        <div class="custom-center">

            <button type="button" class="arrow" aria-label="Option précédente">
                &#10094;
            </button>

            {# Image de la figurine reçue depuis le contrôleur. #}
            <img
                id="figurine-preview"
                src="{{ asset('images/' ~ figurine.image) }}"
                class="figurine-img"
                alt="{{ figurine.nom }}"
            >

            <button type="button" class="arrow" aria-label="Option suivante">
                &#10095;
            </button>

        </div>

        <div class="custom-right">

            <div class="resume-line">
                <span>Prix</span>
                <span>{{ figurine.prixBase }} &euro;</span>
            </div>

            <div class="resume-line">
                <span>Personnalisation</span>
                <span id="custom-name">Aucune</span>
            </div>

            <div class="resume-line">
                <span>Total personnalisation</span>
                <span id="custom-price">0 &euro;</span>
            </div>

            <div class="resume-line total">
                <span>Total</span>
                <span id="total-price">{{ figurine.prixBase }} &euro;</span>
            </div>

            {# Lien mis à jour en JavaScript avec les choix de personnalisation. #}
            <a
                id="btn-panier"
                href="{{ path('panier_add', {
                    id: figurine.id
                }) }}"
                class="btn-panier"
            >
                Ajouter au panier
            </a>

        </div>

    </div>

</section>

<script>

// Prix de base de la figurine envoyé par Twig.
const basePrice = {{ figurine.prixBase }};

function changeFigurine(image, customName = 'Personnalisation', extraPrice = 20)
{
    // Calcule le nouveau total avec l'option choisie.
    const total = basePrice + extraPrice;

    // Remplace l'image de prévisualisation.
    document.getElementById('figurine-preview').src = '/images/' + image;

    // Met à jour le récapitulatif affiché à droite.
    document.getElementById('custom-name').innerText = customName;
    document.getElementById('custom-price').innerText = extraPrice + ' €';
    document.getElementById('total-price').innerText = total + ' €';

    // Envoie les choix vers le panier dans les paramètres d'URL.
    document.getElementById('btn-panier').href =
        '/panier/add/{{ figurine.id }}'
        + '?image=' + encodeURIComponent(image)
        + '&custom=' + encodeURIComponent(customName)
        + '&prix=' + total;
}

function showCategory(category, button)
{
    // Affiche uniquement la catégorie sélectionnée.
    document.querySelectorAll('.category').forEach(cat => {
        cat.classList.add('hidden');
    });

    document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('active');
    });

    document.getElementById(category).classList.remove('hidden');
    button.classList.add('active');
}

</script>

{% endblock %}
