{% extends 'base.html.twig' %}

{% block title %}Personnalisation{% endblock %}

{% block body %}

{% set categories = {
    cheveux: {
        label: 'Cheveux',
        options: [
            { name: 'Hair 1', image: 'Hair1.png', preview: 'preview-v3-hair-1.png', price: 10 },
            { name: 'Hair 2', image: 'Hair2.png', preview: 'preview-v3-hair-2.png', price: 10 },
            { name: 'Hair 3', image: 'Hair3.png', preview: 'preview-v3-hair-3.png', price: 10 },
            { name: 'Hair 4', image: 'Hair4.png', preview: 'preview-v3-hair-4.png', price: 10 }
        ]
    },
    vetement: {
        label: 'Vêtement',
        options: [
            { name: 'Costume 1', image: 'costume1.png', preview: 'preview-v3-costume-1.png', price: 20 },
            { name: 'Costume 2', image: 'Shogun2.png', preview: 'preview-v3-costume-2.png', price: 25 },
            { name: 'Costume 3', image: 'imperiale3.png', preview: 'preview-v3-costume-3.png', price: 30 }
        ]
    },
    accessoire: {
        label: 'Accessoire',
        options: [
            { name: 'Chapeau', image: 'chapeau1.png', preview: 'preview-v3-chapeau.png', price: 8 }
        ]
    }
} %}

<section class="custom-page">

    <h2 class="custom-title">
        Personnalisation de ma figurine
    </h2>

    <div class="tabs" role="tablist" aria-label="Catégories de personnalisation">
        {% for key, category in categories %}
            <button
                type="button"
                data-category-tab="{{ key }}"
                class="tab{% if loop.first %} active{% endif %}"
            >
                {{ category.label }}
            </button>
        {% endfor %}
        <button type="button" data-category-tab="resume" class="tab">
            Résumé
        </button>
    </div>

    <div class="custom-container">

        <div class="custom-left">

            <p class="category-current">
                Catégorie sélectionnée :
                <span id="active-category-label">Cheveux</span>
            </p>

            {% for key, category in categories %}
                <div id="category-{{ key }}" class="category{% if not loop.first %} hidden{% endif %}">

                    <article class="item-card item-card-none">
                        <div class="item-empty">
                            Aucun
                        </div>
                        <button
                            type="button"
                            class="item-btn selected"
                            data-category="{{ key }}"
                            data-name="Aucun"
                            data-image=""
                            data-preview="preview-v3-figurine-base.png"
                            data-price="0"
                        >
                            Aucun
                        </button>
                    </article>

                    {% for option in category.options %}
                        <article class="item-card">
                            <img src="{{ asset('images/' ~ option.image) }}" alt="{{ option.name }}">
                            <button
                                type="button"
                                class="item-btn"
                                data-category="{{ key }}"
                                data-name="{{ option.name }}"
                                data-image="{{ option.image }}"
                                data-preview="{{ option.preview }}"
                                data-price="{{ option.price }}"
                            >
                                {{ option.name }}
                            </button>
                        </article>
                    {% endfor %}

                </div>
            {% endfor %}

            <div id="category-resume" class="category custom-choice-panel hidden">
                <p>Cheveux : <strong id="panel-cheveux">Aucun</strong></p>
                <p>Vêtement : <strong id="panel-vetement">Aucun</strong></p>
                <p>Accessoire : <strong id="panel-accessoire">Aucun</strong></p>
            </div>

        </div>

        <div class="custom-center">

            <button type="button" class="arrow" aria-label="Option précédente">
                &#10094;
            </button>

            <div class="figurine-configurator">
                <img
                    id="figurine-preview"
                    src="{{ asset('images/preview-v3-figurine-base.png') }}"
                    class="figurine-img"
                    alt="{{ figurine.nom }}"
                >

                <div class="applied-options" aria-live="polite">
                    <div class="applied-option" data-slot="cheveux">
                        <span>Cheveux</span>
                        <img id="preview-cheveux" alt="">
                    </div>
                    <div class="applied-option" data-slot="vetement">
                        <span>Vêtement</span>
                        <img id="preview-vetement" alt="">
                    </div>
                    <div class="applied-option" data-slot="accessoire">
                        <span>Accessoire</span>
                        <img id="preview-accessoire" alt="">
                    </div>
                </div>
            </div>

            <button type="button" class="arrow" aria-label="Option suivante">
                &#10095;
            </button>

        </div>

        <div class="custom-right">

            <div class="resume-line">
                <span>Prix de base</span>
                <span>{{ figurine.prixBase }} &euro;</span>
            </div>

            <div class="resume-line">
                <span>Cheveux sélectionnés</span>
                <span id="resume-cheveux">Aucun</span>
            </div>

            <div class="resume-line">
                <span>Vêtement sélectionné</span>
                <span id="resume-vetement">Aucun</span>
            </div>

            <div class="resume-line">
                <span>Accessoire sélectionné</span>
                <span id="resume-accessoire">Aucun</span>
            </div>

            <div class="resume-line">
                <span>Supplément</span>
                <span id="custom-price">0 &euro;</span>
            </div>

            <div class="resume-line total">
                <span>Total</span>
                <span id="total-price">{{ figurine.prixBase }} &euro;</span>
            </div>

            <a
                id="btn-panier"
                href="{{ path('panier_add', {
                    id: figurine.id
                }) }}"
                class="btn-panier"
            >
                Ajouter au panier
            </a>

        </div>

    </div>

</section>

<script>

const basePrice = {{ figurine.prixBase }};
const cartBaseUrl = '{{ path('panier_add', { id: figurine.id }) }}';
const baseImage = 'preview-v3-figurine-base.png';
const labels = {
    cheveux: 'Cheveux',
    vetement: 'Vêtement',
    accessoire: 'Accessoire',
    resume: 'Résumé'
};

const choices = {
    cheveux: createEmptyChoice(),
    vetement: createEmptyChoice(),
    accessoire: createEmptyChoice()
};
let lastPreviewImage = baseImage;

document.querySelectorAll('[data-category-tab]').forEach(button => {
    button.addEventListener('click', () => showCategory(button.dataset.categoryTab, button));
});

document.querySelectorAll('.item-btn').forEach(button => {
    button.addEventListener('click', () => selectOption(button));
});

updateConfigurator();

function createEmptyChoice()
{
    return {
        name: 'Aucun',
        image: '',
        preview: '',
        price: 0
    };
}

function showCategory(category, button)
{
    document.querySelectorAll('.category').forEach(block => {
        block.classList.add('hidden');
    });

    document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('active');
    });

    document.getElementById('category-' + category).classList.remove('hidden');
    document.getElementById('active-category-label').innerText = labels[category];
    button.classList.add('active');
}

function selectOption(button)
{
    const category = button.dataset.category;

    choices[category] = {
        name: button.dataset.name,
        image: button.dataset.image,
        preview: button.dataset.preview,
        price: Number.parseInt(button.dataset.price, 10)
    };

    lastPreviewImage = choices[category].preview !== ''
        ? choices[category].preview
        : getFallbackPreviewImage();

    document.querySelectorAll('.item-btn[data-category="' + category + '"]').forEach(itemButton => {
        itemButton.classList.remove('selected');
    });

    button.classList.add('selected');
    updateConfigurator();
}

function updateConfigurator()
{
    const supplement = choices.cheveux.price + choices.vetement.price + choices.accessoire.price;
    const total = basePrice + supplement;

    updateCategoryText('cheveux');
    updateCategoryText('vetement');
    updateCategoryText('accessoire');
    updatePreview('cheveux');
    updatePreview('vetement');
    updatePreview('accessoire');
    updateMainPreview();

    document.getElementById('custom-price').innerText = supplement + ' €';
    document.getElementById('total-price').innerText = total + ' €';
    updateCartLink(total, supplement);
}

function updateCategoryText(category)
{
    const choice = choices[category];
    const text = choice.price > 0 ? choice.name + ' (+' + choice.price + ' €)' : 'Aucun';

    document.getElementById('resume-' + category).innerText = text;
    document.getElementById('panel-' + category).innerText = text;
}

function updatePreview(category)
{
    const image = document.getElementById('preview-' + category);
    const slot = image.closest('.applied-option');

    if (choices[category].image === '') {
        image.removeAttribute('src');
        slot.classList.remove('has-choice');
        return;
    }

    image.src = '/images/' + choices[category].image;
    slot.classList.add('has-choice');
}

function updateMainPreview()
{
    const image = getMainPreviewImage();

    document.getElementById('figurine-preview').src = '/images/' + image;
}

function getMainPreviewImage()
{
    return lastPreviewImage;
}

function getFallbackPreviewImage()
{
    if (choices.vetement.preview !== '') {
        return choices.vetement.preview;
    }

    if (choices.accessoire.preview !== '') {
        return choices.accessoire.preview;
    }

    if (choices.cheveux.preview !== '') {
        return choices.cheveux.preview;
    }

    return baseImage;
}

function updateCartLink(total, supplement)
{
    const params = new URLSearchParams({
        image: getMainPreviewImage(),
        custom: buildCustomLabel(),
        prix: total,
        cheveux: choices.cheveux.name,
        vetement: choices.vetement.name,
        accessoire: choices.accessoire.name,
        supplement: supplement
    });

    document.getElementById('btn-panier').href = cartBaseUrl + '?' + params.toString();
}

function buildCustomLabel()
{
    const selected = ['cheveux', 'vetement', 'accessoire']
        .map(category => choices[category].name)
        .filter(name => name !== 'Aucun');

    return selected.length > 0 ? selected.join(' + ') : 'Aucune';
}

</script>

{% endblock %}
