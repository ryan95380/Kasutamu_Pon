{% extends 'base.html.twig' %}

{% block title %}Paiement réussi{% endblock %}

{% block body %}

{# Page affichée après un retour positif depuis Stripe. #}
<section class="paiement-retour">
    <h1>Paiement réussi</h1>

    <p>
        Merci pour votre commande. Votre panier a été vidé.
    </p>

    {% if commande %}
        <a href="{{ path('commande_derniere') }}" class="btn-hero">
            Voir ma commande
        </a>
    {% endif %}

    <a href="{{ path('catalogue') }}" class="btn-hero">
        Retour au catalogue
    </a>
</section>

{% endblock %}
