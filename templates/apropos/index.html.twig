{% extends 'base.html.twig' %}

{% block body %}

<section class="hero">
    <div class="hero-center">
        <img class="hero-image" src="{{ asset('images/hero-bg.png') }}" alt="">

        <div class="hero2-text-center hero-about">
            <h1>Kasutamu pon</h1>
            <p class="jp2">カスタム‐ポン</p>
        </div>
    </div>
</section>

<section class="apropos-banner">
    <div class="apropos-container">
        <p>
            Kasutamu Pon est un projet de site e-commerce consacré à la vente de figurines inspirées de l’univers manga,
            dont le but est de proposer une expérience utilisateur simple, fluide et accessible,
            en permettant aux utilisateurs de personnaliser leur figurine à travers différents choix visuels
            avant de passer commande.
        </p>
    </div>
</section>

{% endblock %}