{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}

<!-- Section principale du catalogue -->
<section class="hero">

    <!-- Image décorative gauche -->
    <div class="portrait">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

    <!-- Centre de la page -->
    <div class="catalogue-center">

        <!-- Titre du catalogue -->
        <h2 class="titre-catalogue">
            Catalogue
        </h2>

        <!-- Grille des produits -->
        <div class="catalogue-grid">

            <!-- Boucle sur toutes les figurines -->
            {% for figurine in figurines %}

                <!-- Carte produit -->
                <div class="produit">

                    <!-- Image produit -->
                    <img
                        src="{{ asset('images/' ~ figurine.image) }}"
                        alt="{{ figurine.nom }}"
                    >

                    <!-- Barre bleue sous le produit -->
                    <div class="barre-bleue">

                        <!-- Bouton burger pour afficher les actions -->
                        <button class="toggle-desc">
                            ≡
                        </button>

                        <!-- Actions cachées par défaut -->
                        <div class="actions-produit" style="display:none;">

                            <p class="desc-produit">
                                {{ figurine.description }}
                            </p>

                            <a
                                class="btn-personnaliser"
                                href="{{ path('personnalisation', {
                                    id: figurine.id
                                }) }}"
                            >
                                Personnaliser
                            </a>

                        </div>

                    </div>

                </div>

            {% else %}

                <!-- Message si aucun produit -->
                <p>
                    Aucune figurine disponible.
                </p>

            {% endfor %}

        </div>

    </div>

    <!-- Image décorative droite -->
    <div class="portrait1">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

</section>

<!-- Vague de séparation -->
<section class="wave">

    <img
        src="{{ asset('images/vague2.png') }}"
        alt=""
    >

</section>

<!-- Petit script pour afficher / cacher les actions -->
<script>

document.querySelectorAll('.toggle-desc').forEach(btn => {

    btn.addEventListener('click', () => {

        const desc = btn.nextElementSibling;

        desc.style.display =
            desc.style.display === 'none'
            ? 'block'
            : 'none';

    });

});

</script>

{% endblock %}
