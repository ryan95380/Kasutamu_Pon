{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}

<section class="panier-page">

    <h1 class="titre-panier">
        Panier
    </h1>

    {# Affiche les messages envoyés par le contrôleur panier. #}
    {% for message in app.flashes('panier_info') %}
        <p class="panier-message">
            {{ message }}
        </p>
    {% endfor %}

    {% if panier is empty %}

        <p class="panier-vide">
            Votre panier est vide pour le moment.
        </p>

    {% else %}

        {# Calcule le total général directement pendant l'affichage. #}
        {% set totalGeneral = 0 %}

        <div class="panier-layout">

            <div class="panier-liste">

                {% for item in panier %}

                    {# Calcule le total d'une ligne du panier. #}
                    {% set quantite = item.quantite|default(1) %}
                    {% set ligneTotal = item.prix * quantite %}
                    {% set totalGeneral = totalGeneral + ligneTotal %}

                    <article class="panier-item">

                        <img
                            src="{{ asset('images/' ~ item.image) }}"
                            alt="{{ item.nom }}"
                        >

                        <div class="panier-info">

                            <h3>
                                {{ item.nom }}
                            </h3>

                            <p class="panier-desc">
                                {{ item.description }}
                            </p>

                            <p class="panier-custom">
                                {{ item.custom }}
                            </p>

                            <div class="panier-meta">
                                <span>Prix : {{ item.prix }} &euro;</span>
                                <span>Quantité : {{ quantite }}</span>
                                <span>Total : {{ ligneTotal }} &euro;</span>
                            </div>

                            <a
                                class="btn-supprimer"
                                href="{{ path('panier_remove', {
                                    index: loop.index0
                                }) }}"
                            >
                                Supprimer
                            </a>

                        </div>

                    </article>

                {% endfor %}

            </div>

            {# Récapitulatif utilisé avant la redirection vers Stripe. #}
            <aside class="panier-recap">

                <h2>
                    Récapitulatif
                </h2>

                <div class="recap-line">
                    <span>Articles</span>
                    <span>{{ panier|length }}</span>
                </div>

                <div class="recap-line total">
                    <span>Total</span>
                    <span>{{ totalGeneral }} &euro;</span>
                </div>

                <a
                    class="btn-payer"
                    href="{{ path('panier_paiement') }}"
                >
                    Passer au paiement
                </a>

                <p class="stripe-note">
                    Paiement test sécurisé avec Stripe.
                </p>

            </aside>

        </div>

    {% endif %}

</section>

<section class="wave">
    <img src="{{ asset('images/vague2.png') }}" alt="">
</section>

{% endblock %}
