{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}

<section class="hero">

    <div class="portrait">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

    <div class="catalogue-center">

        <h1 class="titre-panier">Panier</h1>

        {% if panier is empty %}
            <p style="text-align:center;">Votre panier est vide pour le moment.</p>
        {% else %}

        <div class="panier-grid">

            {% for item in panier %}
                <div class="panier-item">

                    <img src="{{ asset('images/' ~ item.image) }}" alt="{{ item.nom }}">

                    <div class="panier-info">
                        <h3>{{ item.nom }}</h3>
                        <p class="panier-desc">{{ item.description }}</p>
                        <p class="panier-prix">{{ item.prix }} €</p>

                        <a class="btn-payer" href="#">
                            Paiement
                        </a>

                        <a class="btn-supprimer" href="{{ path('panier_remove', { index: loop.index0 }) }}">
                            Supprimer
                        </a>
                    </div>

                </div>
            {% endfor %}

        </div>

        {% endif %}

    </div>

</section>


<section class="wave">
    <img src="{{ asset('images/vague2.png') }}" alt="">
</section>

{% endblock %}
