<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Kasutamu Pon{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>

<body>

<header>

    <div class="header-top">

        <img class="logo" src="{{ asset('images/logo.png') }}" alt="logo">

        <nav class="menu">
            <a class="btn-menu active" href="/accueil">Accueil</a>
            <a class="btn-menu" href="{{ path('catalogue') }}">Catalogue</a>
            <a class="btn-menu" href="/personnalisation">Personnalisation</a>
            <a class="btn-menu" href="/panier">Panier</a>
            <a class="btn-menu" href="/admin">Tableau de bord</a>
            <a class="btn-menu active" href="/apropos">À propos</a>
        </nav>

        {% if app.user %}
            <span class="login">Connecté</span>
            <a class="login" href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a class="login" href="#" id="btnLogin">se connecter</a>
        {% endif %}

    </div>

    <div class="header-search">
        <input type="text" placeholder="Rechercher...">
    </div>

</header>

{% block body %}{% endblock %}

<footer class="footer">
    <p>© 2026 Kasutamu Pon</p>
    <div class="social">
        <img src="{{ asset('images/twitter.png') }}">
        <img src="{{ asset('images/Instagram.png') }}">
    </div>
</footer>

{% if not app.user %}
<div id="popupLogin" class="popup-login">

    <div class="popup-box">
        <h3>Connexion</h3>

        {% if error is defined and error %}
            <p style="color:red;">Email ou mot de passe incorrect</p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">

            <label>Email</label>
            <input type="email" name="email" required>

            <label>Mot de passe</label>
            <input type="password" name="password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>

        </form>

        <p>
            Pas de compte ?
            <a href="{{ path('app_inscription') }}">S'inscrire</a>
        </p>

        <p id="closePopup" class="close-btn">Fermer</p>
        <img class="waves1" src="{{ asset('images/vague2.png') }}">
    </div>

</div>
{% endif %}

<script>
var btn = document.getElementById("btnLogin");
var popup = document.getElementById("popupLogin");
var close = document.getElementById("closePopup");

if(btn){
    btn.onclick = function(e){
        e.preventDefault();
        popup.style.display = "flex";
    }
}

if(close){
    close.onclick = function(){
        popup.style.display = "none";
    }
}

if(popup){
    popup.onclick = function(e){
        if(e.target == popup){
            popup.style.display = "none";
        }
    }
}
</script>

</body>
</html>