{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}

<section class="catalogue-page">

    <div class="portrait">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

    <div class="catalogue-center">

        <h2 class="titre-catalogue">
            Catalogue
        </h2>

        <div class="catalogue-grid">

            {# Affiche chaque figurine transmise par le controleur. #}
            {% for figurine in figurines %}

                <article class="produit">

                    <img
                        src="{{ asset('images/' ~ figurine.image) }}"
                        alt="{{ figurine.nom }}"
                    >

                    <div class="produit-info">
                        <h3>
                            {{ figurine.nom }}
                        </h3>

                        <p class="produit-prix">
                            {{ figurine.prixBase }} &euro;
                        </p>

                        {# Envoie l'identifiant de la figurine vers la personnalisation. #}
                        <a
                            class="btn-personnaliser"
                            href="{{ path('personnalisation', {
                                id: figurine.id
                            }) }}"
                        >
                            Personnaliser
                        </a>
                    </div>

                    <div class="barre-bleue">

                        <div class="actions-produit">

                            <p class="desc-produit">
                                {{ figurine.description }}
                            </p>

                        </div>

                    </div>

                </article>

            {% else %}

                {# Message affiche si la base ne contient aucune figurine. #}
                <p class="empty-message">
                    Aucune figurine disponible.
                </p>

            {% endfor %}

        </div>

    </div>

    <div class="portrait1">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

</section>

<section class="wave">
    <img src="{{ asset('images/vague2.png') }}" alt="">
</section>

{% endblock %}
