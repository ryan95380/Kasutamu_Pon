{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}

<section class="hero">

    <div class="portrait">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

    <div class="catalogue-center">

        <h2 class="titre-catalogue">Catalogue</h2>

        <div class="catalogue-grid">

            {% for figurine in figurines %}
                <div class="produit">
                    <img src="{{ asset('images/' ~ figurine.image) }}" alt="{{ figurine.nom }}">

                    <div class="barre-bleue">

                        {# Bouton ≡ pour afficher / cacher la description #}
                        <button class="toggle-desc">≡</button>

                        {# Description cachée par défaut #}
                        <p class="desc-produit" style="display:none;">
                            {{ figurine.description }}
                        </p>

                    </div>
                </div>
            {% else %}
                <p>Aucune figurine disponible.</p>
            {% endfor %}

        </div>

    </div>

    <div class="portrait1">
        <img src="{{ asset('images/samourai.png') }}" alt="">
    </div>

</section>

<section class="wave">
    <img src="{{ asset('images/vague2.png') }}" alt="">
</section>

{# Script pour afficher / cacher la description #}
<script>
document.querySelectorAll('.toggle-desc').forEach(btn => {
    btn.addEventListener('click', () => {
        const desc = btn.nextElementSibling;
        desc.style.display = desc.style.display === 'none' ? 'block' : 'none';
    });
});
</script>

{% endblock %}
