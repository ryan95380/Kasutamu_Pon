<!DOCTYPE html>
<html lang="fr">

<head>


    <!-- Encodage -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Titre -->
    <title>
        {% block title %}Kasutamu Pon{% endblock %}
    </title>

    <!-- CSS -->
    <link
        rel="stylesheet"
        href="{{ asset('css/style.css') }}?v=20260703-01"
    >

    <!-- Icônes -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

</head>

<body>

{# Structure commune utilisée par toutes les pages du site. #}
<!-- Header -->
<header>

    <div class="header-top">

        <!-- Logo -->
        <img
            class="logo"
            src="{{ asset('images/logo.png') }}"
            alt="logo"
        >

        <button
            class="burger"
            id="hamburger"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        {# Navigation principale vers les pages de démonstration. #}
       <nav
                class="menu"
                id="menu"
         >

            <a class="btn-menu active" href="/accueil">
                Accueil
            </a>

            <a
                class="btn-menu"
                href="{{ path('catalogue') }}"
            >
                Catalogue
            </a>

            <a
                class="btn-menu"
                href="/personnalisation/1"
            >
                Personnalisation
            </a>

            <a class="btn-menu" href="/panier">
                Panier
            </a>

            {% if is_granted('ROLE_ADMIN') %}

                <a class="btn-menu" href="/admin">
                    Tableau de bord
                </a>

            {% endif %}

            <a class="btn-menu active" href="/apropos">
                À propos
            </a>

        </nav>

        {# Affiche les actions selon l'état de connexion. #}
        <div
            class="auth-links"
            id="authLinks"
        >

        {% if app.user %}

            <span class="login">
                Connecté
            </span>

            <a
                class="login"
                href="{{ path('app_logout') }}"
            >
                Déconnexion
            </a>

        {% else %}

            <!-- Bouton connexion -->
            <a
                class="login"
                href="#"
                id="btnLogin"
            >
                se connecter
            </a>

        {% endif %}

        </div>

    </div>

    <!-- Barre recherche -->
    <div class="header-search">

        <input
            type="text"
            placeholder="Rechercher..."
        >

    </div>

</header>

<!-- Contenu page -->
{# Chaque template enfant injecte ici son contenu principal. #}
{% block body %}{% endblock %}

<!-- Footer -->
<footer class="footer-new">

    <!-- Infos projet -->
    <div class="footer-col footer-left">

        <h2>
            Kasutamu Pon
        </h2>

        <p>
            Projet réalisé par Ryan Mambou – DWWM
        </p>

        <p>

            Créez et achetez votre figurine

            <br>

            personnalisée de style manga !

        </p>

    </div>

    <!-- Infos -->
    <div class="footer-col">

        <div class="footer-title-box">
            Informations
        </div>

        <ul>

            <li>
                <a href="{{ path('app_cgv') }}">
                    • Conditions Générales de Vente
                </a>
            </li>

            <li>
                <a href="{{ path('app_rgpd') }}">
                    • RGPD
                </a>
            </li>

            <li>
                <a href="{{ path('app_rgpd') }}">
                    • Politique de Confidentialité
                </a>
            </li>

        </ul>

    </div>

    <!-- Contact -->
    <div class="footer-col">

        <div class="footer-title-box">
            Contact
        </div>

        <ul>

            <li>
                • contact@kasutamupon.com
            </li>

            <li>
                • +33 1 23 45 67 89
            </li>

        </ul>

    </div>

    <!-- Réseaux -->
    <div class="footer-col">

        <div class="footer-title-box">
            Suivez-nous
        </div>

        <div class="footer-icons">

            <a href="#" class="insta">
                <i class="fa-brands fa-instagram"></i>
            </a>

            <a href="#" class="twitter">
                <i class="fa-brands fa-twitter"></i>
            </a>

            <a href="#" class="youtube">
                <i class="fa-brands fa-youtube"></i>
            </a>

            <a href="#" class="tiktok">
                <i class="fa-brands fa-tiktok"></i>
            </a>

        </div>

    </div>

</footer>

<!-- Popup connexion -->
{% if not app.user %}

{# Formulaire de connexion affiché en popup pour les visiteurs. #}
<div id="popupLogin" class="popup-login">

    <div class="popup-box">

        <h3>
            Connexion
        </h3>

        <!-- Message erreur -->
        {% if error is defined and error %}

            <p style="color:red;">
                Email ou mot de passe incorrect
            </p>

        {% endif %}

        <!-- Formulaire -->
        <form
            method="post"
            action="{{ path('app_login') }}"
        >

            <label>Email</label>

            <input
                type="email"
                name="email"
                required
            >

            <label>
                Mot de passe
            </label>

            <input
                type="password"
                name="password"
                required
            >

            {# Jeton CSRF utilisé par Symfony pour sécuriser la connexion. #}
            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit">
                Se connecter
            </button>

        </form>

        <!-- Lien inscription -->
        <p>

            Pas de compte ?

            <a href="{{ path('app_inscription') }}">
                S'inscrire
            </a>

        </p>

        <!-- Fermer popup -->
        <p
            id="closePopup"
            class="close-btn"
        >
            Fermer
        </p>

        <!-- Image -->
        <img
            class="waves1"
            src="{{ asset('images/vague2.png') }}"
        >

    </div>

</div>

{% endif %}

<!-- JS popup -->
<script>

/* Récupère les éléments nécessaires à la popup de connexion. */
var btn =
document.getElementById("btnLogin");

/* Popup */
var popup =
document.getElementById("popupLogin");

/* Bouton fermer */
var close =
document.getElementById("closePopup");

/* Ouvre la popup quand l'utilisateur clique sur "se connecter". */
if(btn){

    btn.onclick = function(e){

        e.preventDefault();

        popup.style.display = "flex";
    }
}

/* Ferme la popup avec le bouton dédié. */
if(close){

    close.onclick = function(){

        popup.style.display = "none";
    }
}

/* Ferme popup si clic extérieur */
if(popup){

    popup.onclick = function(e){

        if(e.target == popup){

            popup.style.display = "none";
        }
    }
}

/* Active le menu responsive sur mobile. */

const hamburger =
document.getElementById("hamburger");

const menu =
document.getElementById("menu");

const authLinks =
document.getElementById("authLinks");

if(hamburger && menu){

    hamburger.addEventListener("click", () => {

        menu.classList.toggle("menu-open");

        if(authLinks){

            authLinks.classList.toggle("menu-open");

        }

    });

}

</script>

</body>
</html>
