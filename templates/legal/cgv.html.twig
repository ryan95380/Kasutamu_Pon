{% extends 'base.html.twig' %}

{% block title %}CGV - Kasutamu Pon{% endblock %}

{% block body %}

<section class="legal-hero">

    <div>
        <p class="legal-kicker">Kasutamu Pon</p>
        <h1>Conditions Generales de Vente</h1>
        <p>
            Les regles simples pour commander une figurine personnalisee sur la boutique.
        </p>
    </div>

</section>

<section class="legal-page">

    <div class="legal-intro">
        <strong>Derniere mise a jour :</strong> 2 juillet 2026
    </div>

    <div class="legal-grid">

        <article class="legal-card">
            <span>01</span>
            <h2>Commande</h2>
            <p>
                L'utilisateur choisit une figurine, personnalise son produit puis valide son panier.
                La commande est prise en compte apres validation des informations.
            </p>
        </article>

        <article class="legal-card">
            <span>02</span>
            <h2>Prix et paiement</h2>
            <p>
                Les prix sont indiques en euros. Le paiement doit etre valide avant la preparation
                de la commande.
            </p>
        </article>

        <article class="legal-card">
            <span>03</span>
            <h2>Preparation</h2>
            <p>
                Les produits personnalises sont prepares selon les choix effectues par l'utilisateur
                dans le parcours de personnalisation.
            </p>
        </article>

        <article class="legal-card">
            <span>04</span>
            <h2>Contact</h2>
            <p>
                Pour toute question concernant une commande, l'utilisateur peut contacter le site
                a l'adresse contact@kasutamupon.com.
            </p>
        </article>

    </div>

</section>

{% endblock %}
