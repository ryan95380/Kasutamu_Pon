{% extends 'base.html.twig' %}

{% block body %}

<!-- Petit style pour le fond de la page -->
<style>

body{
    background:
    url("{{ asset('images/FondPage_dinscription.jpg') }}")
    no-repeat center center fixed;

    background-size: cover;
}

</style>

<!-- Section inscription -->
<section class="auth-section">

    <!-- Box du formulaire -->
    <div class="auth-box-custom">

        <!-- Titre -->
        <h2>
            Inscription
        </h2>

        {# Formulaire envoyé au contrôleur d'inscription. #}
        <form method="post">

            <label>
                Nom
            </label>

            <input
                type="text"
                name="nom"
                required
            >

            <label>
                Prénom
            </label>

            <input
                type="text"
                name="prenom"
                required
            >

            <label>
                Email
            </label>

            <input
                type="email"
                name="email"
                required
            >

            <label>
                Mot de passe
            </label>

            <input
                type="password"
                name="password"
                required
            >

            <button type="submit">

                S'inscrire

            </button>

        </form>

    </div>

</section>

{% endblock %}
